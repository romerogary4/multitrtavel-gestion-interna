# Base de datos - Neon PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx.us-east-2.aws.neon.tech/multitravel?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="genera-un-secreto-aleatorio-de-32-caracteres-aqui"
BETTER_AUTH_URL="https://tu-dominio.com"
# En desarrollo:
# BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"
NEXT_PUBLIC_APP_NAME="MultiTravel Cherry Matute"

# Directorio de uploads (ruta en el servidor)
UPLOAD_DIR="/var/www/multitravel/uploads"
# En desarrollo:
# UPLOAD_DIR="./uploads"

# Node environment
NODE_ENV="production"
